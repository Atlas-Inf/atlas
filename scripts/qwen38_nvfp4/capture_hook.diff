+
+/// SCRATCH (not for commit): write `rows` BF16 rows of a GDN projection input
+/// to `<ATLAS_GDN_CAPTURE>/L{ssm:02}_{kind}_{seq:08}.bin` (written as `.tmp`,
+/// then renamed), for a consumer that folds them into X^T X and deletes them.
+pub(super) fn capture_rows(
+    gpu: &dyn GpuBackend,
+    ptr: DevicePtr,
+    rows: usize,
+    cols: usize,
+    kind: &str,
+    stream: u64,
+) -> Result<()> {
+    static QKVZ: AtomicUsize = AtomicUsize::new(0);
+    static OUT: AtomicUsize = AtomicUsize::new(0);
+    static SEQ: AtomicUsize = AtomicUsize::new(0);
+    let Ok(dir) = std::env::var("ATLAS_GDN_CAPTURE") else {
+        return Ok(());
+    };
+    let order = std::sync::atomic::Ordering::SeqCst;
+    let c = if kind == "qkvz" { &QKVZ } else { &OUT }.fetch_add(1, order);
+    let seq = SEQ.fetch_add(1, order);
+    gpu.synchronize(stream)?;
+    let mut buf = vec![0u8; rows * cols * 2];
+    gpu.copy_d2h(ptr, &mut buf)?;
+    let dir = std::path::Path::new(&dir);
+    let name = format!("L{:02}_{kind}_{seq:08}.bin", c % 48);
+    std::fs::write(dir.join(format!("{name}.tmp")), &buf)?;
+    std::fs::rename(dir.join(format!("{name}.tmp")), dir.join(name))?;
+    Ok(())
+}
