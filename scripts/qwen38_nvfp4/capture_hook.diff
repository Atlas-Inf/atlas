+
+/// SCRATCH (not for commit): append `rows` BF16 rows of a GDN projection input
+/// to `<ATLAS_GDN_CAPTURE>/L{ssm:02}_{kind}.bin` (calibration capture).
+pub(super) fn capture_rows(
+    gpu: &dyn GpuBackend,
+    ptr: DevicePtr,
+    rows: usize,
+    cols: usize,
+    kind: &str,
+    stream: u64,
+) -> Result<()> {
+    static QKVZ: AtomicUsize = AtomicUsize::new(0);
+    static OUT: AtomicUsize = AtomicUsize::new(0);
+    let Ok(dir) = std::env::var("ATLAS_GDN_CAPTURE") else {
+        return Ok(());
+    };
+    let c = if kind == "qkvz" { &QKVZ } else { &OUT }.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+    gpu.synchronize(stream)?;
+    let mut buf = vec![0u8; rows * cols * 2];
+    gpu.copy_d2h(ptr, &mut buf)?;
+    use std::io::Write;
+    let mut f = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(std::path::Path::new(&dir).join(format!("L{:02}_{kind}.bin", c % 48)))?;
+    f.write_all(&buf)?;
+    Ok(())
+}
