# SPDX-License-Identifier: AGPL-3.0-only
# Source AFTER qualification.env on both ranks. Candidate, not a qualification
# receipt: keep the existing bounded pool and 32K session limit for first boot.
ATLAS_GLM_KV_SHARD=1
ATLAS_GLM_KV_CANONICAL=1
ATLAS_GLM_CANONICAL_VERIFY=1
ATLAS_GLM_MOE_DECODE_PERSIST=1
ATLAS_DFLASH_COPY_DRAFTS=1
ATLAS_DFLASH_COPY_REPLY_MATCH=16
ATLAS_DFLASH_COPY_MISS_MAX=3
# Conservative launch policy for the initial native RC2 qualification. Full-model
# prefill produced nonfinite values with dependent launch on driver 580.126.09;
# ordinary stream-ordered launches passed C1/C4 parity. The GEMV batch switch needs
# dependent launch, so disable it with PDL. Keep RC2's native cache/kernel paths.
ATLAS_PDL=0
ATLAS_GLM_DECODE_GEMV_BATCH=0
