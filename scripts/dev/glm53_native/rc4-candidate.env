# SPDX-License-Identifier: AGPL-3.0-only
# Source AFTER qualification.env and rc2-candidate.env on BOTH ranks.
# Native RC4 bounded qualification: docs/porting/GLM_5_3_FLASH_RC4.md.
# Keep the inherited 32K session / 8192-block pool for the first boot.
ATLAS_RDMA_ONESHOT_SM_STAGE=1
# One-shot PDL is independent of the general PDL switch.
ATLAS_RDMA_ONESHOT_PDL=0
ATLAS_PDL=0
ATLAS_GLM_DECODE_GEMV_BATCH=0
ATLAS_GLM_MOE_ROUTE_FUSE=1
ATLAS_GLM_DENSE_TP_SPLIT=1
ATLAS_GLM_KDA_COMMIT_CTAS=96
ATLAS_GLM_DRAFT_TP_TOPK=1
ATLAS_DFLASH_ASYNC_UPLOADS=1
ATLAS_GLM_MLA_FUSE=1
ATLAS_GLM_MXFP8_TILED=1
ATLAS_DFLASH2_EDGE=0.6
ATLAS_DFLASH_CONV_TWIN=nvfp4
ATLAS_DFLASH_CONF_PROBE=256
